{
  "name": "counsellor-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/app/server.ts",
    "dev:inspect": "tsx watch --inspect src/app/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/app/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "seed:superadmin": "tsx scripts/seed-superadmin.ts",
    "worker": "tsx src/app/worker.ts",
    "db:indexes": "tsx scripts/sync-indexes.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.7.8",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.3",
    "pino": "^9.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.6",
    "@types/supertest": "^6.0.3",
    "mongodb-memory-server": "^10.4.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
