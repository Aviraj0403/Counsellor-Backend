# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4100

# One Mongo cluster. Master data lives in db "cp_master"; each counsellor org gets its own db "cp_t_<tenantId>".
MONGO_URI=mongodb://127.0.0.1:27017

# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_TTL=1h

# Websites allowed to call this API (browser CORS whitelist). Comma-separated full https origins, no path, no wildcard.
# PLATFORM_ORIGINS = our own apps (always allowed). More domains can be added at runtime by the superadmin: Console > Platform > Allowed domains.
PLATFORM_ORIGINS=https://counsellor.jdinfotechsolutions.in
# CORS_ORIGINS = extra origins from config, for example local development (localhost is also allowed automatically outside production).
CORS_ORIGINS=http://localhost:5173

LOG_LEVEL=info

# local = identity/tenants/modules run inside this repo. remote = call the shared Platform Core service (future).
PLATFORM_MODE=local

# Only used by: npm run seed:superadmin
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Public address of THIS API (used in webhook URLs and public pages), no trailing slash
PUBLIC_BASE_URL=https://apicounsellor.jdinfotechsolutions.in

# AI admissions assistant (module aiBot). Optional: without a key the bot reports itself offline.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_INR_PER_USD=90
# HMAC secret for POST /public/bot/whatsapp/inbound (header x-bot-signature: sha256=<hmac of raw body>)
BOT_INBOUND_SECRET=

# Appointment reminders job: cron/pm2 calls POST /public/appointments/jobs/run-reminders with header x-jobs-secret. At least 16 characters; unset = endpoint refuses.
JOBS_SECRET=

# Redis (BullMQ background worker for delayed WhatsApp messages and webhook retries). Optional in dev (falls back to memory queue).
REDIS_URL=redis://127.0.0.1:6379

# WhatsApp Provider: 'meta' (Meta Cloud API) or 'webhook' (generic fallback HTTP gateway)
WHATSAPP_PROVIDER=meta
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GATEWAY_URL=
WHATSAPP_COST_PER_MESSAGE_PAISE=80
